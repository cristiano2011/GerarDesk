#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/gerardesk/gerardesk /usr/bin/gerardesk

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/gerardesk.service ]; then
			rm -f /etc/systemd/system/gerardesk.service /usr/lib/systemd/system/gerardesk.service /usr/lib/systemd/user/gerardesk.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/gerardesk/files/systemd/gerardesk.service /usr/lib/systemd/system/gerardesk.service
		# try fix error in Ubuntu 18.04
		# Failed to reload gerardesk.service: Unit gerardesk.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/gerardesk.service:10: Executable path is not absolute: pkill -f "gerardesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/gerardesk.service
		fi
		systemctl daemon-reload
		systemctl enable gerardesk
		systemctl start gerardesk
	fi
fi
