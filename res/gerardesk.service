[Unit]
Description=GerarDesk
Requires=network.target
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/gerardesk --service
# kill --tray and --server both
ExecStop=pkill -f "gerardesk --"
# below two lines do not work, have to use above one line
#ExecStop=pkill -f "gerardesk --tray"
#ExecStop=pkill -f "gerardesk --server"
PIDFile=/run/gerardesk.pid
KillMode=mixed
TimeoutStopSec=30
User=root
LimitNOFILE=100000
Environment="PULSE_LATENCY_MSEC=60" "PIPEWIRE_LATENCY=1024/48000"

[Install]
WantedBy=multi-user.target
