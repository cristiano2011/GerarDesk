pkgname=gerardesk
pkgver=1.5.1
pkgrel=0
epoch=
pkgdesc=""
arch=('x86_64')
url=""
license=('AGPL-3.0')
groups=()
depends=('gtk3' 'xdotool' 'libxcb' 'libxfixes' 'alsa-lib' 'libva' 'libappindicator-gtk3' 'gst-plugins-base' 'gst-plugin-pipewire')
makedepends=()
checkdepends=()
optdepends=()
provides=('rustdesk')
conflicts=('rustdesk')
replaces=('rustdesk')
backup=()
options=()
install=pacman_install
changelog=
noextract=()
md5sums=() #generate with 'makepkg -g'

package() {
  if [[ ${FLUTTER} ]]; then
	  mkdir -p "${pkgdir}/usr/share/gerardesk" && cp -r ${HBB}/flutter/build/linux/x64/release/bundle/* -t "${pkgdir}/usr/share/gerardesk"
  fi
  mkdir -p "${pkgdir}/usr/bin"
  pushd ${pkgdir} && ln -s /usr/share/gerardesk/gerardesk usr/bin/gerardesk && popd
  install -Dm 644 $HBB/res/gerardesk.service -t "${pkgdir}/usr/share/gerardesk/files"
  install -Dm 644 $HBB/res/gerardesk.desktop -t "${pkgdir}/usr/share/gerardesk/files"
  install -Dm 644 $HBB/res/gerardesk-link.desktop -t "${pkgdir}/usr/share/gerardesk/files"
  install -Dm 644 $HBB/res/128x128@2x.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/gerardesk.png"
  install -Dm 644 $HBB/res/scalable.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/gerardesk.svg"
}
